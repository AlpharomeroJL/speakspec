{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Speakspec",
    "version":  "1.0.1",
    "identifier":  "com.speakspec.app",
    "build":  {
                  "beforeDevCommand":  "pnpm dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "pnpm build \u0026\u0026 pnpm package:runtime",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Speakspec",
                                    "width":  1100,
                                    "height":  760
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "resources":  {
                                     "resources/speakspec-runtime/":  "speakspec-runtime/"
                                 },
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               }
}
